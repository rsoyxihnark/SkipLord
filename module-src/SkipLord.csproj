<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SkipLord</AssemblyName>
    <RootNamespace>SkipLord</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <ModuleXml>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../module/SkipLord/SubModule.xml'))</ModuleXml>
    <ModuleVersion>$([System.Text.RegularExpressions.Regex]::Match($(ModuleXml), '(?&lt;=&lt;Version\s+value=&quot;v)\d+\.\d+\.\d+(?=&quot;)'))</ModuleVersion>
    <Version>$(ModuleVersion)</Version>
    <AssemblyTitle>SkipLord</AssemblyTitle>
    <Product>SkipLord</Product>
    <Company>SkipLord</Company>
    <Authors>SkipLord</Authors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="1.4.8.119303" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CheckModuleVersion" BeforeTargets="BeforeBuild">
    <Error Condition="'$(ModuleVersion)' == ''" Text="No &lt;Version value=&quot;vX.Y.Z&quot; /&gt; found in module/SkipLord/SubModule.xml" />
  </Target>
</Project>
